# -----------------------------------------------------------------------------
# Family trip tracker (private /f/<token> page)
# -----------------------------------------------------------------------------

# Long unguessable path token. Share only with family.
# Local fallback (if unset): local-dev-family-viaje-slp-cordoba-2026-carla-do-not-use-in-prod
# URL shape: https://ernestovizcaino.com/f/$FAMILY_TRIP_PATH_SECRET
FAMILY_TRIP_PATH_SECRET=

# Separate password required to UPLOAD photos (viewing the page only needs the URL).
FAMILY_TRIP_UPLOAD_SECRET=

# Optional: opensky (default) | aeroapi (swap-ready; falls back to OpenSky for now)
FLIGHT_TRACKER_PROVIDER=opensky
# Optional OpenSky Basic auth for higher rate limits
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
# Future AeroAPI key (not required for MVP)
AEROAPI_KEY=

# Cloudflare R2 (S3-compatible). If unset, album is empty and upload explains "not configured".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for objects, e.g. https://pub-xxxxx.r2.dev or a custom domain
R2_PUBLIC_BASE_URL=
